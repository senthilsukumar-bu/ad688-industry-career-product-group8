        "TARGET_TITLES = [\n",
        "    \"bi \",\n",
        "    \"data \",\n",
        "    \"analytics \",\n",
        "    \"business intelligence \",\n",
        "    \"reporting \",\n",
        "    \"business \",\n",
        "]\n",
        "\n",
        "# Find the title column (adjust if the name differs from what prints above)\n",
        "title_col = next((c for c in jobs_raw.columns if \"title\" in c.lower()), None)\n",
        "print(f\"Using column: {title_col}\")\n",
        "\n",
        "pattern = \"|\".join(TARGET_TITLES)\n",
        "jobs = jobs_raw[jobs_raw[title_col].str.lower().str.contains(pattern, na=False)].copy()\n",
        "print(f\"Filtered rows: {jobs.shape}\")\n",
        "\n",
        "# Save\n",
        "import os\n",
        "os.makedirs(\"./outputs\", exist_ok=True)\n",
        "jobs.to_csv(\"./outputs/api_job_facts.csv\", index=False)\n",
        "print(\"Saved to ./outputs/api_job_facts.csv\")"
      ],
