        "import os\n",
        "import requests\n",
        "import pandas as pd\n",
        "from dotenv import load_dotenv\n",
        "\n",
        "import sys\n",
        "\n",
        "\n",
        "load_dotenv(\"M01_A/m01_data/.env\")\n",
        "load_dotenv()\n",
        "\n",
        "API_KEY = os.getenv(\"EMPLOYABILITY_API_KEY\", \"\").strip()\n",
        "BASE_URL = os.getenv(\"EMPLOYABILITY_API_BASE_URL\", \"https://met-employability-services.azurewebsites.net\").strip().rstrip(\"/\")\n",
        "STUDENT_API_BASE_URL = os.getenv(\"STUDENT_API_BASE_URL\", \"\").strip().rstrip(\"/\")\n",
        "\n",
        "if not API_KEY:\n",
        "    raise RuntimeError(\"EMPLOYABILITY_API_KEY is missing. Add it to .env before rendering this assignment.\")\n",
        "if not BASE_URL:\n",
        "    raise RuntimeError(\"EMPLOYABILITY_API_BASE_URL is missing. Add it to .env before rendering this assignment.\")\n",
        "if not STUDENT_API_BASE_URL:\n",
        "    if BASE_URL.endswith(\"/api/v1/student\"):\n",
        "        STUDENT_API_BASE_URL = BASE_URL\n",
        "    elif BASE_URL.endswith(\"/met-career-match\"):\n",
        "        STUDENT_API_BASE_URL = f\"{BASE_URL}/api/v1\"\n",
        "    else:\n",
        "        STUDENT_API_BASE_URL = f\"{BASE_URL}/api/v1/student\"\n",
        "\n",
        "def api_url(path):\n",
        "    return f\"{STUDENT_API_BASE_URL}/{path.strip('/')}/\"\n",
        "\n",
        "headers = {\"X-API-Key\": API_KEY, \"Accept\": \"application/json\"}\n",
        "\n",
        "schema_response = requests.get(api_url(\"schema\"), timeout=30)\n",
        "schema_response.raise_for_status()\n",
        "print(\"Schema keys:\", list(schema_response.json().keys())[:10])\n",
        "\n",
        "#MAX_RECORDS = 10_000\n",
        "\n",
        "all_rows = []\n",
        "pull_log = []\n",
        "params = {\"naics\": \"5415\", \"limit\": 200, \"offset\": 0}\n",
        "\n",
        "while True:\n",
        "    response = requests.get(api_url(\"jobs\"), headers=headers, params=params, timeout=60)\n",
        "    if response.status_code == 429:\n",
        "        raise RuntimeError(\"Rate limited. Rerun later.\")\n",
        "    response.raise_for_status()\n",
        "    payload = response.json()\n",
        "    page = payload[\"results\"]\n",
        "    if not page:\n",
        "        break\n",
        "    all_rows.extend(page)\n",
        "    pull_log.append({\n",
        "        \"offset\": params[\"offset\"],\n",
        "        \"limit\": params[\"limit\"],\n",
        "        \"status_code\": response.status_code,\n",
        "        \"rows_returned\": len(page),\n",
        "    })\n",
        "    print(f\"offset={params['offset']} | page={len(page)} | total={len(all_rows)}\")\n",
        "    #if len(all_rows) >= MAX_RECORDS:\n",
        "    #    break\n",
        "    params[\"offset\"] += params[\"limit\"]\n",
        "\n",
        "jobs_raw = pd.json_normalize(all_rows)\n",
        "jobs_raw[\"posted_at\"] = pd.to_datetime(jobs_raw[\"posted_at\"], errors=\"coerce\", utc=True)\n",
        "jobs_raw = jobs_raw[jobs_raw[\"posted_at\"] >= pd.Timestamp(\"2026-01-01\", tz=\"UTC\")].copy()\n",
        "print(f\"Raw pull (after date filter): {jobs_raw.shape}\")\n",
        "print(jobs_raw.columns.tolist())"
      ],
