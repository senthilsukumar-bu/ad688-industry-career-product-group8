        "from pyspark.sql import SparkSession\n",
        "from pyspark.sql import functions as F\n",
        "\n",
        "spark = SparkSession.builder \\\n",
        "    .appName(\"AD688_JobFacts\") \\\n",
        "    .config(\"spark.sql.session.timeZone\", \"UTC\") \\\n",
        "    .getOrCreate()\n",
        "spark.sparkContext.setLogLevel(\"ERROR\")\n",
        "\n",
        "# Load from raw API CSV \n",
        "jobs_raw_spark = spark.read.csv(\n",
        "    \"api_job_facts_cleanup2.csv\",\n",
        "    header=True,\n",
        "    inferSchema=True,\n",
        "    multiLine=True,\n",
        "    escape='\"'\n",
        ")\n",
        "\n",
        "FIELD_MAP = {\n",
        "    \"job_id\":                                        \"job_id\",\n",
        "    \"posted_at\":                                     \"posted_at\",\n",
        "    \"title\":                                         \"title\",\n",
        "    \"normalized_title\":                              \"normalized_title\",\n",
        "    \"company_name\":                                  \"company_name\",\n",
        "    \"location_text\":                                 \"location_text\",\n",
        "    \"city\":                                          \"city\",\n",
        "    \"city_code\":                                     \"city_code\",\n",
        "    \"state\":                                         \"state\",\n",
        "    \"state_code\":                                    \"state_code\",\n",
        "    \"remote_status\":                                 \"remote_status\",\n",
        "    \"employment_type\":                               \"employment_type\",\n",
        "    \"salary_text\":                                   \"salary_text\",\n",
        "    \"annual_salary_min\":                             \"annual_salary_min\",\n",
        "    \"annual_salary_max\":                             \"annual_salary_max\",\n",
        "    \"hourly_salary_min\":                             \"hourly_salary_min\",\n",
        "    \"hourly_salary_max\":                             \"hourly_salary_max\",\n",
        "    \"soc_code\":                                      \"soc_code\",\n",
        "    \"soc_name\":                                      \"soc_name\",\n",
        "    \"occupation_family\":                             \"occupation_family\",\n",
        "    \"naics_code\":                                    \"naics_code\",\n",
        "    \"naics_name\":                                    \"naics_name\",\n",
        "    \"onet_code\":                                     \"onet_code\",\n",
        "    \"onet_name\":                                     \"onet_name\",\n",
        "    \"cip_code\":                                      \"cip_code\",\n",
        "    \"cip_name\":                                      \"cip_name\",\n",
        "    \"skills\":                                        \"skills\",\n",
        "    \"program_matches\":                               \"program_matches\",\n",
        "    \"description\":                                   \"description\",\n",
        "    \"bls.employment\":                                \"bls_employment\",\n",
        "    \"bls.annual_mean_wage\":                          \"bls_annual_mean_wage\",\n",
        "    \"bls.annual_median_wage\":                        \"bls_annual_median_wage\",\n",
        "    \"bls.source_year\":                               \"bls_source_year\",\n",
        "    \"student_signals.work_type\":                     \"student_signals_work_type\",\n",
        "    \"student_signals.requirements_summary\":          \"student_signals_requirements_summary\",\n",
        "    \"student_signals.responsibilities_summary\":      \"student_signals_responsibilities_summary\",\n",
        "    \"student_signals.technical_tools_summary\":       \"student_signals_technical_tools_summary\",\n",
        "}\n",
        "\n",
        "select_exprs = []\n",
        "skipped = []\n",
        "for src, alias in FIELD_MAP.items():\n",
        "    if src in jobs_raw_spark.columns:\n",
        "        # Backtick-quote any column name containing a dot (flat CSV column, not a struct)\n",
        "        col_ref = F.col(f\"`{src}`\") if \".\" in src else F.col(src)\n",
        "        select_exprs.append(col_ref.alias(alias))\n",
        "    else:\n",
        "        skipped.append(src)\n",
        "\n",
        "if skipped:\n",
        "    print(f\"Columns not found (skipped): {skipped}\")\n",
        "\n",
        "jobs_selected = jobs_raw_spark.select(select_exprs)\n",
        "jobs_selected.createOrReplaceTempView(\"job_facts_raw\")\n",
        "print(f\"Selected {len(select_exprs)} columns — raw view registered as: job_facts_raw\")\n",
        "jobs_selected.printSchema()\n",
        "\n",
        "jobs_clean = spark.sql(\"\"\"\n",
        "\n",
        "    WITH\n",
        "\n",
        "    -- ── STEP 1: Remove noisy data ──────────────────────────────────────────\n",
        "    -- Rows with null job_id are dropped; they cannot be keyed or joined.\n",
        "    -- Rows with null title are dropped; they are unusable for downstream analysis.\n",
        "    \n",
        "    base AS (\n",
        "        SELECT *\n",
        "        FROM job_facts_raw\n",
        "        WHERE job_id IS NOT NULL\n",
        "          AND title IS NOT NULL\n",
        "    ),\n",
        "\n",
        "    -- ── STEP 2: Normalize categorical labels ─────────────────────────\n",
        "    -- remote_status and employment_type arrive with inconsistent casing\n",
        "    -- and freeform strings (e.g. \"REMOTE\", \"Remote Work\", \"wfh\").\n",
        "    -- Map to four canonical values. \n",
        "    -- Any unrecognized value defaults to 'Unknown' rather than NULL so aggregations are more meaningful.\n",
        "    labeled AS (\n",
        "        SELECT *,\n",
        "\n",
        "        CASE\n",
        "            WHEN LOWER(TRIM(remote_status)) IN ('remote', 'fully remote', 'work from home', 'wfh', 'remote work')\n",
        "                OR LOWER(TRIM(remote_status)) LIKE '%remote%' AND LOWER(TRIM(remote_status)) NOT LIKE '%partial%'\n",
        "                OR LOWER(TRIM(remote_status)) LIKE '%wfh%'\n",
        "                OR LOWER(TRIM(remote_status)) LIKE '%home%'\n",
        "                THEN 'Remote'\n",
        "            WHEN LOWER(TRIM(remote_status)) IN ('hybrid', 'hybrid remote', 'partial remote', 'hybrid/remote')\n",
        "                OR LOWER(TRIM(remote_status)) LIKE '%hybrid%'\n",
        "                OR LOWER(TRIM(remote_status)) LIKE '%partial%'\n",
        "                THEN 'Hybrid'\n",
        "            WHEN LOWER(TRIM(remote_status)) IN ('on-site', 'onsite', 'in-office', 'in office', 'on site', 'office')\n",
        "                OR LOWER(TRIM(remote_status)) LIKE '%office%'\n",
        "                OR LOWER(TRIM(remote_status)) LIKE '%site%'\n",
        "                THEN 'On-site'\n",
        "            ELSE 'Unknown'\n",
        "        END AS remote_status_clean,\n",
        "\n",
        "        CASE\n",
        "            WHEN LOWER(TRIM(employment_type)) IN ('full-time', 'full time', 'fulltime', 'ft', 'permanent')\n",
        "                OR LOWER(TRIM(employment_type)) LIKE '%permanent%'\n",
        "                OR LOWER(TRIM(employment_type)) LIKE '%full%'\n",
        "                THEN 'Full-time'\n",
        "            WHEN LOWER(TRIM(employment_type)) IN ('part-time', 'part time', 'parttime', 'pt')\n",
        "                OR LOWER(TRIM(employment_type)) LIKE '%part%'\n",
        "                THEN 'Part-time'\n",
        "            WHEN LOWER(TRIM(employment_type)) IN ('contract', 'contractor', 'temp', 'temporary', 'freelance', 'c2c')\n",
        "                OR LOWER(TRIM(employment_type)) LIKE '%contract%'\n",
        "                OR LOWER(TRIM(employment_type)) LIKE '%temp%'\n",
        "                OR LOWER(TRIM(employment_type)) LIKE '%freelance%'\n",
        "                THEN 'Contract'\n",
        "            WHEN LOWER(TRIM(employment_type)) IN ('internship', 'intern', 'co-op', 'coop')\n",
        "                OR LOWER(TRIM(employment_type)) LIKE '%intern%'\n",
        "                THEN 'Internship'\n",
        "            ELSE 'Unknown'\n",
        "        END AS employment_type_clean\n",
        "\n",
        "\n",
        "        FROM base\n",
        "    ),\n",
        "\n",
        "    -- ── STEP 3: Salary outlier handling ─────────────────────────────\n",
        "    -- Salary fields contain a few data errors: $0, $1, implausibly high values from mis-parsed hourly-to-annual conversions, or potentially test records. \n",
        "    -- Values outside plausible BI/analytics bands are set to NULL (even without salary data, the post itself e.g. skills are useful)\n",
        "    -- WHERE Annual band:  $20,000 – $500,000\n",
        "    -- WHERE Hourly band:  $10  – $250\n",
        "    -- WHERE NOT min > max (data entry error)\n",
        "    -- WHERE NOT both are set to NULL.\n",
        "    salaries AS (\n",
        "        SELECT *,\n",
        "\n",
        "            CASE\n",
        "                WHEN CAST(annual_salary_min AS DOUBLE) BETWEEN 20000 AND 500000\n",
        "                 AND CAST(annual_salary_max AS DOUBLE) BETWEEN 20000 AND 500000\n",
        "                 AND CAST(annual_salary_min AS DOUBLE) <= CAST(annual_salary_max AS DOUBLE)\n",
        "                    THEN CAST(annual_salary_min AS DOUBLE)\n",
        "                ELSE NULL\n",
        "            END AS annual_salary_min_clean,\n",
        "\n",
        "            CASE\n",
        "                WHEN CAST(annual_salary_min AS DOUBLE) BETWEEN 20000 AND 500000\n",
        "                 AND CAST(annual_salary_max AS DOUBLE) BETWEEN 20000 AND 500000\n",
        "                 AND CAST(annual_salary_min AS DOUBLE) <= CAST(annual_salary_max AS DOUBLE)\n",
        "                    THEN CAST(annual_salary_max AS DOUBLE)\n",
        "                ELSE NULL\n",
        "            END AS annual_salary_max_clean,\n",
        "\n",
        "            CASE\n",
        "                WHEN CAST(hourly_salary_min AS DOUBLE) BETWEEN 10 AND 250\n",
        "                 AND CAST(hourly_salary_max AS DOUBLE) BETWEEN 10 AND 250\n",
        "                 AND CAST(hourly_salary_min AS DOUBLE) <= CAST(hourly_salary_max AS DOUBLE)\n",
        "                    THEN CAST(hourly_salary_min AS DOUBLE)\n",
        "                ELSE NULL\n",
        "            END AS hourly_salary_min_clean,\n",
        "\n",
        "            CASE\n",
        "                WHEN CAST(hourly_salary_min AS DOUBLE) BETWEEN 10 AND 250\n",
        "                 AND CAST(hourly_salary_max AS DOUBLE) BETWEEN 10 AND 250\n",
        "                 AND CAST(hourly_salary_min AS DOUBLE) <= CAST(hourly_salary_max AS DOUBLE)\n",
        "                    THEN CAST(hourly_salary_max AS DOUBLE)\n",
        "                ELSE NULL\n",
        "            END AS hourly_salary_max_clean\n",
        "\n",
        "        FROM labeled\n",
        "    )\n",
        "\n",
        "    -- ── FINAL SELECT ─────────────────────────────────────────────────\n",
        "    -- Replace raw categorical and salary columns with cleaned versions.\n",
        "    -- All other optional fields (city, soc_code, bls_*, skills, etc.)\n",
        "    SELECT\n",
        "        job_id,\n",
        "        posted_at,\n",
        "        title,\n",
        "        normalized_title,\n",
        "        company_name,\n",
        "        location_text,\n",
        "        city,\n",
        "        city_code,\n",
        "        state,\n",
        "        state_code,\n",
        "        remote_status_clean                          AS remote_status,\n",
        "        employment_type_clean                        AS employment_type,\n",
        "        salary_text,\n",
        "        annual_salary_min_clean                      AS annual_salary_min,\n",
        "        annual_salary_max_clean                      AS annual_salary_max,\n",
        "        hourly_salary_min_clean                      AS hourly_salary_min,\n",
        "        hourly_salary_max_clean                      AS hourly_salary_max,\n",
        "        soc_code,\n",
        "        soc_name,\n",
        "        occupation_family,\n",
        "        naics_code,\n",
        "        naics_name,\n",
        "        onet_code,\n",
        "        onet_name,\n",
        "        cip_code,\n",
        "        cip_name,\n",
        "        skills,\n",
        "        program_matches,\n",
        "        description,\n",
        "        bls_employment,\n",
        "        bls_annual_mean_wage,\n",
        "        bls_annual_median_wage,\n",
        "        bls_source_year,\n",
        "        student_signals_work_type,\n",
        "        student_signals_requirements_summary,\n",
        "        student_signals_responsibilities_summary,\n",
        "        student_signals_technical_tools_summary\n",
        "\n",
        "    FROM salaries\n",
        "\n",
        "\"\"\")\n",
        "\n",
        "# Register as the canonical SQL view for all downstream analysis\n",
        "jobs_clean.createOrReplaceTempView(\"job_facts\")\n",
        "print(f\"Clean rows: {jobs_clean.count()}\")\n",
        "jobs_clean.show(5, truncate=60)\n",
        "\n",
        "jobs_clean.toPandas().to_csv(\"./outputs/api_job_facts_cleaned.csv\", index=False)\n",
        "print(\"Saved → ./outputs/api_job_facts_cleaned.csv\")"
      ],
